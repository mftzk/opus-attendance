# PostgreSQL connection used by the app, the migration runner and the seeder.
DATABASE_URL=postgres://attendance:attendance@localhost:5432/opus_attendance

# Shared demo account created by the seeder.
DEMO_EMAIL=demo@attendance.app
DEMO_PASSWORD=demo12345
DEMO_NAME=Demo Teacher

# Time zone used to decide what "today" means for attendance.
APP_TIMEZONE=Asia/Jakarta

# Set to false to skip demo seeding during the release step.
SEED_DEMO=true
